# Public local development bind address; no application API exists.
VITE_HOST=127.0.0.1
# Public development and preview port, also used by browser tests.
VITE_PORT=5173
# Browser-test connection host; use loopback when binding Vite to 0.0.0.0.
E2E_HOST=127.0.0.1
# Browser-test server port; independent runs may override it.
E2E_PORT=5173
